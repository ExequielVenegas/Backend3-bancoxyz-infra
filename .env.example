# Copiar a .env y completar localmente. No subir credenciales.
ACCOUNT_DB_USERNAME=root
ACCOUNT_DB_PASSWORD=
ACCOUNT_DB_URL=jdbc:mysql://host.docker.internal:3306/lab_batch
# Generar con scripts/Initialize-LocalSecurity.ps1. No usar estos campos vacios.
AUTH_WEB_CLIENT_SECRET=
AUTH_MOBILE_CLIENT_SECRET=
AUTH_ATM_CLIENT_SECRET=
AUTH_KEYSTORE_PASSWORD=
# Cambiar si cambia la IP publica de EC2. Mantener coherente el certificado y advertised.listeners.
KAFKA_BOOTSTRAP_SERVERS=100.29.239.217:9093
# Generar con scripts/Initialize-CustomerDatabase.ps1. Esquema independiente de lab_batch.
CUSTOMER_DB_URL=jdbc:mysql://host.docker.internal:3306/bancoxyz_customers
CUSTOMER_DB_USERNAME=bancoxyz_customer
CUSTOMER_DB_PASSWORD=
PAYMENT_DB_URL=jdbc:mysql://host.docker.internal:3306/bancoxyz_payments
PAYMENT_DB_USERNAME=bancoxyz_payment
PAYMENT_DB_PASSWORD=

# Batch EFT local: preparar con Initialize-EftBatchDatabase.ps1
EFT_BATCH_DB_URL=jdbc:mysql://127.0.0.1:3306/bancoxyz_batch_eft
EFT_BATCH_DB_USERNAME=bancoxyz_batch_eft
EFT_BATCH_DB_PASSWORD=
